<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:background="@color/bg_secondary">
        <ImageButton android:id="@+id/btnBack" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="back" android:src="@android:drawable/ic_media_previous" android:tint="@color/accent"/>
        <ImageButton android:id="@+id/btnForward" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="forward" android:src="@android:drawable/ic_media_next" android:tint="@color/accent"/>
        <EditText android:id="@+id/urlBar" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@color/bg_tertiary" android:hint="Search or URL" android:textColorHint="@color/text_secondary" android:textColor="@color/text_primary" android:inputType="textUri" android:imeOptions="actionGo" android:singleLine="true" android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="14sp"/>
        <ImageButton android:id="@+id/btnHome" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="home" android:src="@android:drawable/ic_menu_view" android:tint="@color/accent"/>
        <ImageButton android:id="@+id/btnMenu" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:contentDescription="menu" android:src="@android:drawable/ic_menu_more" android:tint="@color/accent"/>
    </LinearLayout>
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="2dp" android:max="100" android:progressTint="@color/accent" android:progressBackgroundTint="@color/border"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="match_parent" android:importantForAutofill="yes"/>
        <LinearLayout android:id="@+id/retryBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:background="@color/bg_tertiary" android:orientation="horizontal" android:padding="8dp" android:visibility="gone">
            <TextView android:id="@+id/retryText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Page failed to load" android:textColor="@color/text_primary"/>
            <Button android:id="@+id/btnRetry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Retry" android:textColor="@color/bg_primary" android:backgroundTint="@color/accent"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/missingWeb" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/bg_primary" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Android System WebView is missing or disabled" android:textColor="@color/danger" android:textSize="18sp"/>
            <Button android:id="@+id/btnFixWebview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Open WebView settings" android:layout_marginTop="12dp" android:textColor="@color/bg_primary" android:backgroundTint="@color/accent"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/homePanel" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/bg_primary">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AmniBrowse" android:textColor="@color/accent" android:textSize="22sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your chrome stays put. WebView underneath. Google Password Manager via Android Autofill." android:textColor="@color/text_secondary" android:paddingTop="8dp"/>
            <Button android:id="@+id/btnImport" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Import Chrome (PC file)" android:textColor="@color/bg_primary" android:backgroundTint="@color/accent" android:layout_marginTop="16dp"/>
            <Button android:id="@+id/btnDefault" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Set as default browser" android:textColor="@color/accent" android:backgroundTint="@color/bg_tertiary" android:layout_marginTop="8dp"/>
            <ListView android:id="@+id/bookmarkList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="12dp"/>
        </LinearLayout>
    </FrameLayout>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="44dp" android:background="@color/bg_secondary" android:fillViewport="true">
        <LinearLayout android:id="@+id/tabStrip" android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp"/>
    </HorizontalScrollView>
</LinearLayout>
