namespace cef
use ffi
use os
use math
extern "libcef.so" {
	cef_execute_process(args uint, app uint, si uint) i32 = "cef_execute_process";
	cef_initialize(args uint, settings uint, app uint, si uint) i32 = "cef_initialize";
	cef_shutdown() i32 = "cef_shutdown";
	cef_do_message_loop_work() i32 = "cef_do_message_loop_work";
	cef_create(wi uint, client uint, url uint, st uint, extra uint, ctx uint) i32 = "cef_browser_host_create_browser";
	cef_utf8_to_16(src uint, n uint, out uint) i32 = "cef_string_utf8_to_utf16";
	cef_utf16_to_8(src uint, n uint, out uint) i32 = "cef_string_utf16_to_utf8";
	cef_utf8_clear(s uint) i32 = "cef_string_utf8_clear";
	cef_api_hash(version i32, entry i32) uint = "cef_api_hash";
}
extern "libc.so.6" {
	c_exit(code i32) i32 = "exit";
	c_readlink(p uint, buf uint, n uint) int = "readlink";
}
extern f32_bits(x f32) u32 = "hr_f32_bits"
API := 15200
SET_SIZE := 448
SET_NO_SANDBOX := 8
SET_SUBPROC := 16
SET_WINDOWLESS := 96
SET_ROOT_CACHE := 128
SET_LOG := 256
SET_RES := 288
SET_LOC := 312
SET_BG := 344
WIN_SIZE := 88
WIN_WINDOWLESS := 56
WIN_STYLE := 80
STYLE_ALLOY := 2
BRS_SIZE := 264
BRS_RATE := 8
BRS_BG := 248
CLIENT_SIZE := 192
CL_DISPLAY := 72
CL_LIFE := 144
CL_LOAD := 152
CL_RENDER := 168
RH_SIZE := 176
RH_VIEW_RECT := 56
RH_SCREEN_INFO := 72
RH_POPUP_SHOW := 80
RH_POPUP_SIZE := 88
RH_PAINT := 96
LS_SIZE := 88
LS_BEFORE_POPUP := 40
LS_AFTER_CREATED := 64
LS_BEFORE_CLOSE := 80
DH_SIZE := 144
DH_ADDRESS := 40
DH_TITLE := 48
LH_SIZE := 72
LH_LOADING := 40
B_RELEASE := 16
BR_HOST := 48
BR_BACK := 64
BR_FORWARD := 80
BR_RELOAD := 96
BR_ID := 120
BR_MAIN_FRAME := 152
H_CLOSE := 48
H_FOCUS := 72
H_RESIZED := 304
H_HIDDEN := 312
H_SCREEN_CHANGED := 320
H_INVALIDATE := 328
H_KEY := 344
H_CLICK := 352
H_MOVE := 360
H_WHEEL := 368
FR_LOAD_URL := 144
KEY_SIZE := 40
var HOLD byte[>..] = []
var ARGS byte[>..] = []
var ARGV byte[>..] = []
var SETTINGS byte[>..] = []
var WININFO byte[>..] = []
var BRSET byte[>..] = []
var URLSTR byte[>..] = []
var TMP byte[>..] = []
var CLIENT byte[>..] = []
var RENDER byte[>..] = []
var LIFE byte[>..] = []
var DISPLAY byte[>..] = []
var LOAD byte[>..] = []
var EV byte[>..] = []
var EXE byte[>..] = []
var BROWSER uint = 0
var TABS uint[>..] = []
var TAB_IDS int[>..] = []
var TITLES byte[>..][>..] = []
var ACTIVE int = -1
var CLOSED_N int = 0
var CLOSED bool = false
var STARTED bool = false
var VIEW_W int = 800
var VIEW_H int = 600
var SCALE f32 = 1.0
var PAGE byte[>..] = []
var PAGE_W int = 0
var PAGE_H int = 0
var DIRTY bool = false
var PAINTS int = 0
var POPUP byte[>..] = []
var POP_X int = 0
var POP_Y int = 0
var POP_W int = 0
var POP_H int = 0
var POP_SHOWN bool = false
var TITLE byte[>..] = []
var TITLE_NEW bool = false
var URL byte[>..] = []
var PENDING byte[>..] = []
var LOADING bool = false
var CAN_BACK bool = false
var CAN_FORWARD bool = false
cz(s const byte[:]) uint:
	if HOLD.len == 0 { HOLD.reserve(1048576) }
	o := HOLD.len
	HOLD.append(s)
	HOLD.push(0)
	ffi::ptr(HOLD[o..])
put8(b byte[>..]&, off int, v uint): for i 8 { b[off + i] = ((v >> (8 * i) as uint) & 255) as! byte }
put4(b byte[>..]&, off int, v int): for i 4 { b[off + i] = ((v >> (8 * i)) & 255) as! byte }
poke4(p uint, v int): b byte[>..] ~= [0, 0, 0, 0]; put4(b, 0, v); ffi::write(p, b[..])
peek4(p uint) int: b := ffi::bytes(p, 4); v ~= 0; for i 4 { v |= (b[i] as int) << (8 * i) } if v >= 2147483648 { v - 4294967296 } else { v }
peek8(p uint) uint: b := ffi::bytes(p, 8); v ~= 0 as uint; for i 8 { v |= (b[i] as uint) << (8 * i) as uint } v
vt(obj uint, off int) uint: peek8(obj + off as uint)
rel(obj uint): if obj != 0 { c_call<i32>(vt(obj, B_RELEASE), obj) }
set_str(slot uint, s const byte[:]): cef_utf8_to_16(cz(s), s.len as uint, slot)
tab_of(browser uint) int:
	id := c_call<i32>(vt(browser, BR_ID), browser)
	for t, i TAB_IDS:
		if t == id:
			return i
	-1
is_active(browser uint) bool:
	tab_of(browser) == ACTIVE
ref_add(obj uint):
	return
ref_release(obj uint) i32:
	0
ref_one(obj uint) i32:
	1
none(obj uint) uint:
	0
base(b byte[>..]&, size int):
	b.clear()
	b.resize(size, 0)
	put8(b, 0, size as uint)
	put8(b, 8, c_callback(ref_add))
	put8(b, 16, c_callback(ref_release))
	put8(b, 24, c_callback(ref_one))
	put8(b, 32, c_callback(ref_one))
	stub := c_callback(none)
	o ~= 40
	while o + 8 <= size:
		put8(b, o, stub)
		o += 8
get_render(obj uint) uint:
	ffi::ptr(RENDER[..])
get_life(obj uint) uint:
	ffi::ptr(LIFE[..])
get_display(obj uint) uint:
	ffi::ptr(DISPLAY[..])
get_load(obj uint) uint:
	ffi::ptr(LOAD[..])
view_rect(obj uint, browser uint, rect uint):
	poke4(rect, 0)
	poke4(rect + 4, 0)
	poke4(rect + 8, VIEW_W)
	poke4(rect + 12, VIEW_H)
	rel(browser);
screen_info(obj uint, browser uint, info uint) i32:
	poke4(info + 8, f32_bits(SCALE) as int)
	poke4(info + 12, 24)
	poke4(info + 16, 8)
	poke4(info + 20, 0)
	poke4(info + 24, 0)
	poke4(info + 28, 0)
	poke4(info + 32, VIEW_W)
	poke4(info + 36, VIEW_H)
	poke4(info + 40, 0)
	poke4(info + 44, 0)
	poke4(info + 48, VIEW_W)
	poke4(info + 52, VIEW_H)
	rel(browser)
	1
popup_show(obj uint, browser uint, show i32):
	POP_SHOWN = show != 0
	if !POP_SHOWN:
		DIRTY = true
	rel(browser);
popup_size(obj uint, browser uint, rect uint):
	s real := SCALE
	x real := peek4(rect)
	y real := peek4(rect + 4)
	w real := peek4(rect + 8)
	h real := peek4(rect + 12)
	POP_X = round(x * s) as int
	POP_Y = round(y * s) as int
	POP_W = round(w * s) as int
	POP_H = round(h * s) as int
	rel(browser);
draw_popup():
	if !POP_SHOWN || POPUP.len == 0 || POPUP.len != POP_W * POP_H * 4:
		return
	x0 := max(0, 0 - POP_X)
	x1 := min(POP_W, PAGE_W - POP_X)
	if x1 <= x0:
		return
	for row POP_H:
		y := POP_Y + row
		if y >= 0 && y < PAGE_H:
			d := (y * PAGE_W + POP_X + x0) * 4
			s := (row * POP_W + x0) * 4
			for k (x1 - x0) * 4:
				PAGE[d + k] = POPUP[s + k]
paint(obj uint, browser uint, kind i32, nrects uint, rects uint, buffer uint, width i32, height i32):
	if !is_active(browser):
		rel(browser)
		return
	PAINTS += 1
	w int := width
	h int := height
	n := w * h * 4
	if kind == 0:
		if PAGE.len != n:
			PAGE.resize(n, 0)
		PAGE_W = w
		PAGE_H = h
		ffi::read(buffer, PAGE[..])
		draw_popup()
		DIRTY = true
	else if kind == 1:
		POPUP.resize(n, 0)
		POP_W = w
		POP_H = h
		ffi::read(buffer, POPUP[..])
		draw_popup()
		DIRTY = true
	rel(browser);
set_title(i int, s const byte[:]):
	old byte[>..][>..] ~= []
	for t TITLES:
		old.push(t)
	TITLES.clear()
	for t, k old:
		if k == i:
			TITLES.push(s)
		else:
			TITLES.push(t)
after_created(obj uint, browser uint):
	TABS.push(browser)
	TAB_IDS.push(c_call<i32>(vt(browser, BR_ID), browser))
	empty byte[>..] ~= []
	TITLES.push(empty)
	select(TABS.len - 1);
host_flag(off int, v i32):
	h := host()
	if h != 0:
		c_call<i32>(vt(h, off), h, v)
		rel(h)
select(i int):
	if i < 0 || i >= TABS.len:
		return
	if BROWSER != 0 && ACTIVE != i:
		host_flag(H_HIDDEN, 1 as i32)
	ACTIVE = i
	BROWSER = TABS[i]
	POP_SHOWN = false
	host_flag(H_HIDDEN, 0 as i32)
	call_host(H_RESIZED)
	host_flag(H_INVALIDATE, 0 as i32)
	focus(true)
	TITLE.clear()
	for t, k TITLES:
		if k == i:
			TITLE.append(t)
	TITLE_NEW = true;
cycle(step int):
	n := TABS.len
	if n >= 2:
		select((ACTIVE + step + n) % n)
before_close(obj uint, browser uint):
	CLOSED_N += 1
	if CLOSED_N >= TABS.len:
		CLOSED = true
	rel(browser);
before_popup(obj uint, browser uint, frame uint, popup_id i32, target_url uint) i32:
	s := read_str(target_url)
	PENDING.clear()
	PENDING.append(s)
	rel(browser)
	rel(frame)
	1
address_change(obj uint, browser uint, frame uint, url uint):
	if is_active(browser):
		s := read_str(url)
		URL.clear()
		URL.append(s)
	rel(browser)
	rel(frame);
title_change(obj uint, browser uint, title uint):
	s := read_str(title)
	i := tab_of(browser)
	if i >= 0:
		set_title(i, s[..])
		if i == ACTIVE:
			TITLE.clear()
			TITLE.append(s)
			TITLE_NEW = true
	rel(browser);
loading_change(obj uint, browser uint, loading i32, back i32, forward i32):
	if is_active(browser):
		LOADING = loading != 0
		CAN_BACK = back != 0
		CAN_FORWARD = forward != 0
	rel(browser);
read_str(p uint) byte[>..]:
	out byte[>..] ~= []
	if p != 0:
		data := peek8(p)
		n := peek8(p + 8)
		TMP.clear()
		TMP.resize(24, 0)
		slot := ffi::ptr(TMP[..])
		cef_utf16_to_8(data, n, slot)
		text := ffi::bytes(peek8(slot), peek8(slot + 8) as int)
		out.append(text)
		cef_utf8_clear(slot)
	out
exe_path() const byte[:]:
	if EXE.len == 0:
		buf byte[>..] ~= []
		buf.resize(4096, 0)
		n := c_readlink(cz("/proc/self/exe"), ffi::ptr(buf[..]), 4096)
		if n > 0:
			EXE.append(buf[..n])
		else:
			arg(0, EXE)
	EXE[..]
push_arg_ptr(v uint):
	o := ARGV.len
	ARGV.resize(o + 8, 0)
	put8(ARGV, o, v)
seal_args():
	put4(ARGS, 0, ARGV.len / 8 - 1)
	put8(ARGS, 8, ffi::ptr(ARGV[..]))
fill_args():
	ARGS.clear()
	ARGS.resize(16, 0)
	ARGV.clear()
	ARGV.reserve(65536)
	for i arg_count():
		a byte[>..] ~= []
		arg(i, a)
		push_arg_ptr(cz(a[..]))
	push_arg_ptr(0)
	seal_args()
add_arg(s const byte[:]):
	put8(ARGV, ARGV.len - 8, cz(s))
	push_arg_ptr(0)
	seal_args()
boot():
	cef_api_hash(API as i32, 0)
	fill_args()
	code := cef_execute_process(ffi::ptr(ARGS[..]), 0, 0)
	if code >= 0:
		c_exit(code as i32);
cef_dir() byte[>..]:
	out byte[>..] ~= []
	if !env("HELIUM_CEF_DIR", out) || out.len == 0:
		out.clear()
		env("HOME", out)
		out.append("/.cache/hc/cef-152-linux64")
	out
profile_dir() byte[>..]:
	out byte[>..] ~= []
	if !env("XDG_CACHE_HOME", out) || out.len == 0:
		out.clear()
		env("HOME", out)
		out.append("/.cache")
	make_dir(out[..])
	out.append("/amni-browse-helium")
	make_dir(out[..])
	out
view_size(width int, height int, scale f32):
	s real := scale
	w real := width
	h real := height
	VIEW_W = max(round(w / s) as int, 1)
	VIEW_H = max(round(h / s) as int, 1)
start(url const byte[:], width int, height int, scale f32) bool:
	if STARTED:
		return true
	SCALE = scale
	view_size(width, height, scale)
	add_arg("--no-first-run")
	add_arg("--no-default-browser-check")
	add_arg("--disable-extensions")
	add_arg("--no-zygote")
	add_arg("--ozone-platform=x11")
	add_arg("--disable-accelerated-video-decode")
	add_arg("--disable-features=VaapiVideoDecoder,VaapiVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxGL,VaapiIgnoreDriverChecks")
	SETTINGS.clear()
	SETTINGS.resize(SET_SIZE, 0)
	put8(SETTINGS, 0, SET_SIZE as uint)
	put4(SETTINGS, SET_NO_SANDBOX, 1)
	put4(SETTINGS, SET_WINDOWLESS, 1)
	put4(SETTINGS, SET_LOG, 3)
	put4(SETTINGS, SET_BG, 4294967295)
	at := ffi::ptr(SETTINGS[..])
	set_str(at + SET_SUBPROC as uint, exe_path())
	profile := profile_dir()
	set_str(at + SET_ROOT_CACHE as uint, profile[..])
	res := cef_dir()
	set_str(at + SET_RES as uint, res[..])
	loc := cef_dir()
	loc.append("/locales")
	set_str(at + SET_LOC as uint, loc[..])
	if cef_initialize(ffi::ptr(ARGS[..]), at, 0, 0) == 0:
		return false
	base(RENDER, RH_SIZE)
	put8(RENDER, RH_VIEW_RECT, c_callback(view_rect))
	put8(RENDER, RH_SCREEN_INFO, c_callback(screen_info))
	put8(RENDER, RH_POPUP_SHOW, c_callback(popup_show))
	put8(RENDER, RH_POPUP_SIZE, c_callback(popup_size))
	put8(RENDER, RH_PAINT, c_callback(paint))
	base(LIFE, LS_SIZE)
	put8(LIFE, LS_BEFORE_POPUP, c_callback(before_popup))
	put8(LIFE, LS_AFTER_CREATED, c_callback(after_created))
	put8(LIFE, LS_BEFORE_CLOSE, c_callback(before_close))
	base(DISPLAY, DH_SIZE)
	put8(DISPLAY, DH_ADDRESS, c_callback(address_change))
	put8(DISPLAY, DH_TITLE, c_callback(title_change))
	base(LOAD, LH_SIZE)
	put8(LOAD, LH_LOADING, c_callback(loading_change))
	base(CLIENT, CLIENT_SIZE)
	put8(CLIENT, CL_DISPLAY, c_callback(get_display))
	put8(CLIENT, CL_LIFE, c_callback(get_life))
	put8(CLIENT, CL_LOAD, c_callback(get_load))
	put8(CLIENT, CL_RENDER, c_callback(get_render))
	WININFO.clear()
	WININFO.resize(WIN_SIZE, 0)
	put8(WININFO, 0, WIN_SIZE as uint)
	put4(WININFO, WIN_WINDOWLESS, 1)
	put4(WININFO, WIN_STYLE, STYLE_ALLOY)
	BRSET.clear()
	BRSET.resize(BRS_SIZE, 0)
	put8(BRSET, 0, BRS_SIZE as uint)
	put4(BRSET, BRS_RATE, 60)
	put4(BRSET, BRS_BG, 4294967295)
	STARTED = true
	open(url)
open(url const byte[:]) bool:
	if URLSTR.len == 0:
		URLSTR.resize(24, 0)
	slot := ffi::ptr(URLSTR[..])
	set_str(slot, url)
	cef_create(ffi::ptr(WININFO[..]), ffi::ptr(CLIENT[..]), slot, ffi::ptr(BRSET[..]), 0, 0) != 0
pump():
	if STARTED:
		cef_do_message_loop_work()
	if PENDING.len > 0 && BROWSER != 0:
		load(PENDING[..])
		PENDING.clear()
host() uint:
	if BROWSER == 0:
		return 0
	c_call<uint>(vt(BROWSER, BR_HOST), BROWSER)
call_host(off int):
	h := host()
	if h != 0:
		c_call<i32>(vt(h, off), h)
		rel(h)
mods(shift bool, ctrl bool, alt bool, gui bool, buttons int) int:
	f ~= 0
	if shift:
		f |= 2
	if ctrl:
		f |= 4
	if alt:
		f |= 8
	if gui:
		f |= 128
	if (buttons & 1) != 0:
		f |= 16
	if (buttons & 2) != 0:
		f |= 32
	if (buttons & 4) != 0:
		f |= 64
	f
mouse_event(x int, y int, flags int) uint:
	s real := SCALE
	px real := x
	py real := y
	EV.clear()
	EV.resize(12, 0)
	put4(EV, 0, floor(px / s) as int)
	put4(EV, 4, floor(py / s) as int)
	put4(EV, 8, flags)
	ffi::ptr(EV[..])
mouse_move(x int, y int, flags int):
	h := host()
	if h != 0:
		ev := mouse_event(x, y, flags)
		c_call<i32>(vt(h, H_MOVE), h, ev, 0 as i32)
		rel(h)
mouse_button(x int, y int, button int, down bool, clicks int, flags int):
	if button < 1 || button > 3:
		return
	h := host()
	if h != 0:
		ev := mouse_event(x, y, flags)
		up i32 := if down { 0 } else { 1 }
		c_call<i32>(vt(h, H_CLICK), h, ev, (button - 1) as i32, up, clicks as i32)
		rel(h)
wheel(x int, y int, dx real, dy real, flags int):
	h := host()
	if h != 0:
		ev := mouse_event(x, y, flags)
		c_call<i32>(vt(h, H_WHEEL), h, ev, round(dx * 120.0) as i32, round(dy * 120.0) as i32)
		rel(h)
key(kind int, vk int, native int, flags int, ch int):
	h := host()
	if h != 0:
		k byte[>..] ~= []
		k.resize(KEY_SIZE, 0)
		put8(k, 0, KEY_SIZE as uint)
		put4(k, 8, kind)
		put4(k, 12, flags)
		put4(k, 16, vk)
		put4(k, 20, native)
		put4(k, 24, 0)
		lo := (ch & 255) as! byte
		hi := ((ch >> 8) & 255) as! byte
		k[28] = lo
		k[29] = hi
		k[30] = lo
		k[31] = hi
		put4(k, 32, 0)
		c_call<i32>(vt(h, H_KEY), h, ffi::ptr(k[..]))
		rel(h)
focus(on bool):
	h := host()
	if h != 0:
		v i32 := if on { 1 } else { 0 }
		c_call<i32>(vt(h, H_FOCUS), h, v)
		rel(h)
resize(width int, height int, scale f32):
	view_size(width, height, scale)
	if scale != SCALE:
		SCALE = scale
		call_host(H_SCREEN_CHANGED)
	call_host(H_RESIZED)
load(url const byte[:]):
	if BROWSER == 0:
		return
	f := c_call<uint>(vt(BROWSER, BR_MAIN_FRAME), BROWSER)
	if f != 0:
		slot := ffi::ptr(URLSTR[..])
		set_str(slot, url)
		c_call<i32>(vt(f, FR_LOAD_URL), f, slot)
		rel(f)
call_browser(off int):
	if BROWSER != 0:
		c_call<i32>(vt(BROWSER, off), BROWSER)
back():
	call_browser(BR_BACK)
forward():
	call_browser(BR_FORWARD)
reload():
	call_browser(BR_RELOAD)
stop():
	if !STARTED:
		return
	for b TABS:
		h := c_call<uint>(vt(b, BR_HOST), b)
		if h != 0:
			c_call<i32>(vt(h, H_CLOSE), h, 1 as i32)
			rel(h)
	begun := clock()
	while !CLOSED && clock() - begun < 2.0:
		pump()
		sleep_ms(7)
	for b TABS:
		rel(b)
	TABS.clear()
	TAB_IDS.clear()
	TITLES.clear()
	BROWSER = 0
	cef_shutdown()
	STARTED = false
